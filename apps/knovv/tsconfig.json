{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node", "@cloudflare/workers-types"],
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "server",
    "tests",
    "vite.config.ts",
    "cloudflare.config.ts",
    "agent",
    "bench"
  ]
}
